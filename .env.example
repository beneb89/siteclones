# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Hosted ditto.site service (optional; only needed for the REST/MCP API,
# not for the local CLI). Get a key at https://www.ditto.site/api-key
DITTO_API_KEY=
DITTO_API_URL=https://api.ditto.site

# Pin the vendored toolchain to a branch, tag or commit (default: main)
DITTO_REF=main
